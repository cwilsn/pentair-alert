# Leave HOST empty to discover the adapter by UDP broadcast on the local subnet.
SCREENLOGIC_HOST=
# Use the port returned by discovery. For a manually configured host, port 80 is assumed.
SCREENLOGIC_PORT=
SCREENLOGIC_SYSTEM_NAME=
SCREENLOGIC_PASSWORD=
SCREENLOGIC_DISCOVERY_MS=5000
SCREENLOGIC_REQUEST_TIMEOUT_MS=10000
DIAGNOSTICS_OUTPUT=diagnostics.json

# Local website and alert watcher.
PORT=3000
BIND_HOST=0.0.0.0
POLL_INTERVAL_SECONDS=30
ALERT_DELAY_MINUTES=5
ALERT_OFFLINE_MINUTES=5
MONITOR_STATE_FILE=.monitor-state.json

# Create an application at https://pushover.net/apps/build and copy your user key from https://pushover.net/.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
